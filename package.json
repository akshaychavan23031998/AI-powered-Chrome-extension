{
  "name": "workday-ai-application-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered Chrome extension for intelligent Workday job application automation.",
  "scripts": {
    "dev:extension": "npm --workspace apps/extension run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "build:extension": "npm --workspace apps/extension run build",
    "build:api": "npm --workspace apps/api run build",
    "test": "npm run test --workspaces --if-present"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "keywords": [
    "workday",
    "chrome-extension",
    "automation",
    "gemini",
    "job-application"
  ],
  "author": "Akshay Chavan",
  "license": "MIT"
}